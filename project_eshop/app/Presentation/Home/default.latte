<!-- Šablona obsahující HTML a to co přijde z PHP + CSS a JS -->
<!-- podobne 11ty(Eleventy) -->

{block title}Vítejte{/block}	<!-- block = funkcionalita .latte šablonovaciho systému -> určuje co se kam vloží v hlavním @layout.latte kde se strapuje -->


{block content}

	<section id="greetCarousel" class="carousel slide greet-carousel z-0">
		<div class="carousel-indicators m-auto mb-3">
			<button type="button" data-bs-target="#greetCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
			<button type="button" data-bs-target="#greetCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
			<button type="button" data-bs-target="#greetCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
		</div>
		<div class="carousel-inner">
			<div class="carousel-item active">
				<img src="{$basePath}/assets/promos/1.png" class="d-block" alt="...">

			</div>
			<div class="carousel-item">
				<img src="https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80" class="d-block" alt="...">

			</div>
			<div class="carousel-item">
				<img src="https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80" class="d-block" alt="...">

			</div>
		</div>
		<button class="carousel-control-prev" type="button" data-bs-target="#greetCarousel" data-bs-slide="prev">
			<span class="carousel-control-prev-icon" aria-hidden="true"></span>
			<span class="visually-hidden">Previous</span>
		</button>
		<button class="carousel-control-next" type="button" data-bs-target="#greetCarousel" data-bs-slide="next">
			<span class="carousel-control-next-icon" aria-hidden="true"></span>
			<span class="visually-hidden">Next</span>
		</button>
	</section>

	<h2 class="mb-5 mt-5 h1 section-title fw-bolder">Nejnovější produkty</h2>

	<section class="d-flex  justify-content-center align-baseline gap-5 flex-wrap product-list " >
		<div n:foreach="$products as $product">
			<!-- <h2><a href="{link Item:show $product->id}">{$product->creation_date}</a></h2> -->
			<div class="card border-1 rounded-3 product-card" style="width: 18rem;">
				<div class="card-image">
					<img src="{$basePath}/assets/images/{$product->images}/card/card_img.png" alt="Logo">
				</div>
				<div class="card-body">
					<a n:href="Item:show $product->id"><h5 class="card-title">{$product->name}</h5></a>
					<p class="card-text">Some quick example text to build on the card title and make up the bulk of the card’s content.</p>
				</div>
				<ul class="list-group list-group-flush">
					<li class="list-group-item">Rating {$product->star_rating|truncate:256}/5</li>
					<li class="list-group-item"><p>Prodejce: <a n:href="SellerPortfolio:portfolio $product->seller_id" class="card-link">{$product->seller->name}</a></p></li>
				</ul>
			</div>
		</div>
	</section>
	<a n:href="ProductList:products" type="button" class="btn btn-primary btn-lg mt-4 d-flex align-items-center justify-content-center gap-4 homepage-products-btn">
		Zobrazit celou nabídku zde
		<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-arrow-right-circle" style="width: 2rem" viewBox="0 0 16 16">
			<path fill-rule="evenodd" d="M1 8a7 7 0 1 0 14 0A7 7 0 0 0 1 8m15 0A8 8 0 1 1 0 8a8 8 0 0 1 16 0M4.5 7.5a.5.5 0 0 0 0 1h5.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5z"/>
		</svg>
	</a>

	<hr class="border border-danger border-2 opacity-50"/>

	<h2 class="mb-5 mt-5 h1 section-title fw-bolder">Proč si vybrat nás?</h2>

	<section class="d-flex justify-content-around align-baseline gap-5 flex-wrap product-list border-1">
		<div class="chooseUs-content d-flex flex-column justify-content-around align-items-center">
			<div class="chooseUs-image">
				<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-tag" viewBox="0 0 16 16">
					<path d="M6 4.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m-1 0a.5.5 0 1 0-1 0 .5.5 0 0 0 1 0"/>
					<path d="M2 1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 1 6.586V2a1 1 0 0 1 1-1m0 5.586 7 7L13.586 9l-7-7H2z"/>
				</svg>
			</div>
			<h4>Nejlepší nabídky každý den</h4>
			<p>
				Už nemusíte čekat na sezónní výprodeje, u nás šetříte při každém nákupu. Naše denní menu slev přináší
				prémiovou kvalitu za ceny, které jinde nenajdete. Stačí si vybrat tu svou a začít využívat výhody naplno.
			</p>
		</div>
		<div class="chooseUs-content d-flex flex-column justify-content-around align-items-center">
			<div class="chooseUs-image">
				<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-chat-dots" viewBox="0 0 16 16">
					<path d="M5 8a1 1 0 1 1-2 0 1 1 0 0 1 2 0m4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0m3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
					<path d="m2.165 15.803.02-.004c1.83-.363 2.948-.842 3.468-1.105A9 9 0 0 0 8 15c4.418 0 8-3.134 8-7s-3.582-7-8-7-8 3.134-8 7c0 1.76.743 3.37 1.97 4.6a10.4 10.4 0 0 1-.524 2.318l-.003.011a11 11 0 0 1-.244.637c-.079.186.074.394.273.362a22 22 0 0 0 .693-.125m.8-3.108a1 1 0 0 0-.287-.801C1.618 10.83 1 9.468 1 8c0-3.192 3.004-6 7-6s7 2.808 7 6-3.004 6-7 6a8 8 0 0 1-2.088-.272 1 1 0 0 0-.711.074c-.387.196-1.24.57-2.634.893a11 11 0 0 0 .398-2"/>
				</svg>
			</div>
			<h4>Pomoc když je potřeba!</h4>
			<p>
				Nevíte si rady s výběrem nebo potřebujete poradit s objednávkou? Naše podpora je tu pro vás na
				chatu i telefonu, aby vám nákup maximálně usnadnila.
			</p>
		</div>
		<div class="chooseUs-content d-flex flex-column justify-content-around align-items-center">
			<div class="chooseUs-image">
				<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-truck" viewBox="0 0 16 16">
					<path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5zm1.294 7.456A2 2 0 0 1 4.732 11h5.536a2 2 0 0 1 .732-.732V3.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .294.456M12 10a2 2 0 0 1 1.732 1h.768a.5.5 0 0 0 .5-.5V8.35a.5.5 0 0 0-.11-.312l-1.48-1.85A.5.5 0 0 0 13.02 6H12zm-9 1a1 1 0 1 0 0 2 1 1 0 0 0 0-2m9 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2"/>
				</svg>
			</div>
			<h4>Rychlé a efektivní doručení</h4>
			<p>
				Víme, že váš čas je drahocenný, proto vaši objednávku expedujeme dříve, než stačíte říct „hotovo“.
				Díky precizní logistice sledujete cestu balíčku v reálném čase až k vašim dveřím.
			</p>
		</div>
		<div class="chooseUs-content d-flex flex-column justify-content-around align-items-center">
			<div class="chooseUs-image">
				<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-code-slash" viewBox="0 0 16 16">
					<path d="M10.478 1.647a.5.5 0 1 0-.956-.294l-4 13a.5.5 0 0 0 .956.294zM4.854 4.146a.5.5 0 0 1 0 .708L1.707 8l3.147 3.146a.5.5 0 0 1-.708.708l-3.5-3.5a.5.5 0 0 1 0-.708l3.5-3.5a.5.5 0 0 1 .708 0m6.292 0a.5.5 0 0 0 0 .708L14.293 8l-3.147 3.146a.5.5 0 0 0 .708.708l3.5-3.5a.5.5 0 0 0 0-.708l-3.5-3.5a.5.5 0 0 0-.708 0"/>
				</svg>
			</div>
			<h4>TODO</h4>
		</div>
	</section>


{/block} <!-- Pokud nic nenásleduje tak nemusí zde být uzavírka, ale radši ji sem dávat BUDU!! -->
