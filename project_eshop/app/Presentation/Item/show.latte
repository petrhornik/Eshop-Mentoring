{block title}Detail produktu: {$product->name ?? ('#' . $product->id)}{/block}

{block content}
    {var $productName = $product->name ?? ('Produkt #' . $product->id)}
    {var $productDescription = $product->description ?? 'K tomuto produktu zatím není připraven detailní popis.'}
    {var $cardImage = $basePath . '/assets/images/' . ($product->images ?? 'electronics/1') . '/card/card_img.png'}
    {var $detailImageBase = $basePath . '/assets/images/' . ($product->images ?? 'electronics/1') . '/item'}
    {var $galleryImages = [
        ['src' => $detailImageBase . '/1.png', 'alt' => $productName . ' - hlavní pohled'],
        ['src' => $detailImageBase . '/2.png', 'alt' => $productName . ' - detail'],
        ['src' => $detailImageBase . '/3.png', 'alt' => $productName . ' - další pohled'],
    ]}
    {var $price = $productData['price'] ?? null}
    {var $rating = $product->star_rating ?? null}
    {var $sellerName = $product->seller->name ?? null}
    {var $category = $productData['category'] ?? null}
    {var $stock = $productData['stock'] ?? null}
    {var $sellerLocation = 'Marketplace partner'}
    {var $stockLabel = $stock ? 'Skladem' : 'Ověřit dostupnost'}

    <section class="item-show-page py-5">
        <div class="item-page-shell">
            <div class="item-page-topbar">
                <a n:href="ProductList:products" class="item-back-link">
                    <span aria-hidden="true">←</span>
                    Zpět na nabídku
                </a>

                <div class="item-top-pills">
                    <span class="item-top-pill">Kurátorský výběr</span>
                    <span class="item-top-pill item-top-pill-accent">Marketplace detail</span>
                </div>
            </div>

            <div class="item-hero">
                <div class="item-media-column">
                    <div id="itemGallery" class="carousel slide item-gallery-card shadow-sm">
                        <div class="carousel-indicators item-gallery-indicators">
                            <button n:foreach="$galleryImages as $index => $image"
                                    type="button"
                                    data-bs-target="#itemGallery"
                                    data-bs-slide-to="{$index}"
                                    class="{if $index === 0}active{/if}"
                                    aria-current="{if $index === 0}true{/if}"
                                    aria-label="Snímek {$index + 1}"></button>
                        </div>

                        <div class="carousel-inner">
                            <div n:foreach="$galleryImages as $index => $image"
                                 class="carousel-item item-gallery-slide {if $index === 0}active{/if}">
                                <img src="{$image['src']}"
                                     alt="{$image['alt']}"
                                     class="item-gallery-image"
                                     onerror="this.onerror=null;this.src='{$cardImage}';">
                            </div>
                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#itemGallery" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Předchozí</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#itemGallery" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Další</span>
                        </button>
                    </div>

                    <div class="item-thumbnail-row">
                        <button n:foreach="$galleryImages as $index => $image"
                                type="button"
                                class="item-thumbnail"
                                data-bs-target="#itemGallery"
                                data-bs-slide-to="{$index}"
                                aria-label="Zobrazit náhled {$index + 1}">
                            <img src="{$image['src']}"
                                 alt="{$image['alt']}"
                                 class="item-thumbnail-image"
                                 onerror="this.onerror=null;this.src='{$cardImage}';">
                        </button>
                    </div>
                </div>

                <div class="item-summary-column">
                    <div class="item-summary-card shadow-sm">
                        <div class="item-badges">
                            <span class="item-badge">Top nabídka</span>
                            <span class="item-badge">Expedice do 24 h</span>
                            {if $rating !== null}
                                <span class="item-badge item-badge-highlight">Hodnocení {$rating}/5</span>
                            {/if}
                        </div>

                        <h1 class="item-title">{$productName}</h1>
                        <p class="item-lead">{$productDescription}</p>

                        <div class="item-highlight-grid">
                            <div class="item-highlight-box">
                                <span class="item-highlight-label">Cena</span>
                                <strong class="item-highlight-value">
                                    {if $pricing !== null}
                                        {$pricing->price_no_vat} Kč
                                    {else}
                                        Na dotaz
                                    {/if}
                                </strong>
                            </div>
                            <div class="item-highlight-box">
                                <span class="item-highlight-label">Prodejce</span>
                                <strong class="item-highlight-value">
                                    {if $sellerName}
                                        <a n:href="SellerPortfolio:portfolio $product->seller_id" class="item-inline-link">{$sellerName}</a>
                                    {else}
                                        Neuvedeno
                                    {/if}
                                </strong>
                            </div>
                        </div>

                        <div class="item-store-strip">
                            <div>
                                <span>Marketplace store</span>
                                <strong>{if $sellerName}{$sellerName}{else}Neuvedeno{/if}</strong>
                            </div>
                            <div>
                                <span>Lokalita</span>
                                <strong>{$sellerLocation}</strong>
                            </div>
                            <div>
                                <span>Dostupnost</span>
                                <strong>{$stockLabel}</strong>
                            </div>
                        </div>

                        <div class="item-cta-row">
                            <a
                                    class="btn btn-primary btn-lg item-primary-btn"
                                    n:href="addToCart! $product->id">
                                Přidat do košíku
                            </a>
                            <a n:href="ProductList:products" class="btn btn-outline-dark btn-lg item-secondary-btn">
                                Pokračovat v nákupu
                            </a>
                        </div>

                        <dl class="item-meta-list">
                            <div class="item-meta-row">
                                <dt>ID produktu</dt>
                                <dd>#{$product->id}</dd>
                            </div>
                            {if $category !== null && $category !== ''}
                                <div class="item-meta-row">
                                    <dt>Kategorie</dt>
                                    <dd>{$category}</dd>
                                </div>
                            {/if}
                            {if $product->creation_date ?? null}
                                <div class="item-meta-row">
                                    <dt>V nabídce od</dt>
                                    <dd>{$product->creation_date|date:'d.m.Y'}</dd>
                                </div>
                            {/if}
                        </dl>
                    </div>
                </div>
            </div>

            <div class="item-detail-grid">
                <article class="item-content-card shadow-sm">
                    <div class="item-section-heading">
                        <span class="item-section-kicker">Produkt overview</span>
                        <h2>Co stojí za pozornost</h2>
                    </div>
                    <p>{$productDescription}</p>
                    <p class="item-content-note">
                        Detail drží stejný marketplace rytmus jako homepage i výpis produktů: silný hero, jasné výhody a rychlá cesta zpět k nákupu.
                    </p>
                </article>

                <aside class="item-content-card shadow-sm">
                    <div class="item-section-heading">
                        <span class="item-section-kicker">Quick facts</span>
                        <h2>Na první pohled</h2>
                    </div>
                    <div class="item-quick-facts">
                        <div class="item-fact">
                            <span class="item-fact-label">Stav skladovosti</span>
                            <strong>{$stockLabel}</strong>
                        </div>
                        <div class="item-fact">
                            <span class="item-fact-label">Hodnocení</span>
                            <strong>{if $rating !== null}{$rating}/5{else}Bez hodnocení{/if}</strong>
                        </div>
                        <div class="item-fact">
                            <span class="item-fact-label">Seller storefront</span>
                            <strong>{if $sellerName}<a n:href="SellerPortfolio:portfolio $product->seller_id" class="item-inline-link">{$sellerName}</a>{else}Neuvedeno{/if}</strong>
                        </div>
                    </div>
                </aside>
            </div>

            {if $product->trailer_video ?? null}
                <section class="item-video-card shadow-sm">
                    <div class="item-section-heading">
                        <span class="item-section-kicker">Ukázka</span>
                        <h2>Video prezentace produktu</h2>
                    </div>
                    <div class="item-video-frame">
                        <iframe src="https://www.youtube.com/embed/{$product->trailer_video}"
                                title="Video prezentace produktu {$productName}"
                                allowfullscreen
                                scrolling="no"
                                allow="accelerometer *; clipboard-write *; encrypted-media *; gyroscope *; picture-in-picture *; web-share *;"
                                referrerpolicy="strict-origin"
                                loading="lazy"></iframe>
                    </div>
                </section>
            {/if}
        </div>
    </section>
{/block}
