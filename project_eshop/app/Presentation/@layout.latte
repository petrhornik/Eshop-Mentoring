<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width">

	<title>{ifset title}{include title|stripHtml} | {/ifset}Muj Eshop</title>
	<style>
		[x-cloak] {
			display: none !important;
		}
	</style>

	{asset? 'main.js'}
		<link rel="stylesheet" href="{asset? 'CSS/home.css'}">
		<link rel="stylesheet" href="{asset? 'CSS/layout.css'}">
		<link rel="stylesheet" href="{asset? 'CSS/item.css'}">
		<link rel="shortcut icon" href="{$basePath}/www/assets/web_assets/favicon.png" type="image/x-icon">

	<!-- Bootstrap 5 CSS + JSko -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
	<!-- AOS CSS (Animace při scrollování) -->
	<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
	<!-- Animate.css pro animaci košíku -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
	<!-- alpineJS -->
	<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
	<!-- google recapchaV2 -->
	<script src="https://www.google.com/recaptcha/api.js" async defer></script>
</head>

<body x-data="{
	user_form_open: false,
	showPassword: false,
	user_form_chooser: 1,
	captchaStatus: false,
	captchaError: false,
	websiteLocation: window.location.pathname,
	shopping_cart: { items: [], total: 0 },
	cart_flyout_open: false,
	cart_flyout_timeout: null,
	openFlyout() {
		if (this.cart_flyout_timeout) {
			clearTimeout(this.cart_flyout_timeout);
			this.cart_flyout_timeout = null;
		}
		this.cart_flyout_open = true;
	},
	closeFlyout() {
		if (this.cart_flyout_timeout) {
			clearTimeout(this.cart_flyout_timeout);
		}
		this.cart_flyout_timeout = setTimeout(() => {
			this.cart_flyout_open = false;
			this.cart_flyout_timeout = null;
		}, 120);
	}
}">
	<nav class="navbar navbar-expand-lg p-3 fs-5 position-sticky top-0 shadow-sm">
		<div class="d-flex justify-content-between w-100 container-fluid">
			<a class="d-flex align-items-center gap-2 navbar-brand fs-3 mb-0 fw-bold" href="#">
				<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-cart-check" viewBox="0 0 16 16">
					<path d="M11.354 6.354a.5.5 0 0 0-.708-.708L8 8.293 6.854 7.146a.5.5 0 1 0-.708.708l1.5 1.5a.5.5 0 0 0 .708 0z"/>
					<path d="M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h7a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 3H2.89l-.405-1.621A.5.5 0 0 0 2 1zm3.915 10L3.102 4h10.796l-1.313 7zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0m7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
				</svg>
				Muj Eshop
			</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse" id="navbarSupportedContent">
				<ul class="navbar-nav mb-2 mb-lg-0 ms-auto">
					<li class="nav-item">
						<a class="nav-link" :class="websiteLocation === '/' && 'active border-bottom border-2 border-black'" aria-current="page" n:href="Home:default">Hlavní stránka</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" :class="websiteLocation.includes('/product-list') && 'active border-bottom border-2 border-black'" n:href="ProductList:products">Produkty</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" :class="websiteLocation.includes('/about-us') && 'active border-bottom border-2 border-black'" n:href="AboutUs:about">O nás</a>
					</li>
				</ul>
				<div class="cart-nav-wrapper"
					 data-cart-hover-area
					 @mouseenter="openFlyout()"
					 @mouseleave="closeFlyout()">
					<a type="button"
					   n:href="ShoppingCart:overview"
					   class="btn btn-outline-dark d-flex align-items-center gap-2 cart-nav-button"
					   :class="websiteLocation.includes('/shopping-cart') && 'btn btn-primary'"
					   data-cart-button
					   @focus="openFlyout()"
					   @blur="closeFlyout()">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-basket" viewBox="0 0 16 16">
							<path d="M5.757 1.071a.5.5 0 0 1 .172.686L3.383 6h9.234L10.07 1.757a.5.5 0 1 1 .858-.514L13.783 6H15a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1v4.5a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 1 13.5V9a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h1.217L5.07 1.243a.5.5 0 0 1 .686-.172zM2 9v4.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V9zM1 7v1h14V7zm3 3a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0v-3A.5.5 0 0 1 4 10m2 0a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0v-3A.5.5 0 0 1 6 10m2 0a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0v-3A.5.5 0 0 1 8 10m2 0a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0v-3a.5.5 0 0 1 .5-.5m2 0a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0v-3a.5.5 0 0 1 .5-.5"/>
						</svg>
						<span class="badge text-bg-secondary" data-cart-count>{$cart_items_count}</span>
					</a>

					<div class="cart-flyout shadow-sm"
						 data-cart-flyout
						 x-cloak
						 x-show="cart_flyout_open"
						 x-transition.opacity.duration.150ms
						 @mouseenter="openFlyout()"
						 @mouseleave="closeFlyout()">
						<div class="cart-flyout-header">
							<strong>Košík</strong>
							<span data-cart-count-label>0 produktů</span>
						</div>
						<div class="cart-flyout-list" data-cart-preview-list></div>
						<div class="cart-flyout-empty" data-cart-preview-empty>
							Košík je zatím prázdný.
						</div>
						<div class="cart-flyout-footer">
							<a n:href="ShoppingCart:overview" class="btn btn-primary w-100">Otevřít košík</a>
						</div>
					</div>
				</div>
				<a href="#" @click="user_form_open = !user_form_open">
					<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-person-circle text-black mx-2" viewBox="0 0 16 16" style="width: 2rem">
						<path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
						<path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
					</svg>
				</a>
				{if (!$isLoggedIn)}
					<a n:href="UserForm:login">Přihlásit</a>
					{else}
						<a n:href="UserLogout!">Odhlásit se</a>
				{/if}
			</div>
		</div>
	</nav>


	<section class="d-flex flex-column align-items-center top-0">
		<div class="overlay align-items-center justify-content-center" x-show="user_form_open">
			<div class="form-user w-25 mx-auto rounded-3 p-2 bg-white flex-column align-self-center align-items-center p-4" x-show="user_form_chooser === 1">
				<a class="align-self-end " @click="user_form_open = !user_form_open">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle" viewBox="0 0 16 16">
						<path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
						<path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
					</svg>
				</a>
				<div class="d-flex flex-column ">
					<h2 class="w-100">Vítejte zpět!</h2>
					<h3>
						{if $activeUser}
							{$activeUser->name}
						{else}
							Uživatel nepřihlášen...
						{/if}
					</h3>

				</div>
			</div>
		</div>
		{include content}
	</section>

	<footer class="py-5 mt-5 bg-dark d-flex flex-column align-items-center justify-content-center">
		<section class="d-flex justify-content-around align-items-start text-light footer-content">
			<div class="d-flex justify-content-center gap-3 text-light align-center">
				<h4>Sledujte nás: </h4>
				<a href="https://www.instagram.com">IG</a>
				<a href="https://www.youtube.com">YT</a>
				<a href="https://www.facebook.com">FB</a>
				<a href="https://www.x.com">X</a>
			</div>
			<div>
				<h4>Informace: </h4>
				<p><span>ICO</span>123456789</p>
				<p><span>IBAN</span>123456789</p>
				<p><span>Adresa</span>Praha 8, Hl. m. Praha</p>
				<p><Span>Nevim</Span>:D</p>
			</div>
			<div class="map-address-field">
				<h4>Kde nás nadete:</h4>
				<div style="position: relative; width: 100%; padding-bottom: 56.25%; overflow: hidden;"><iframe style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;" loading="lazy" allowfullscreen src="https://maps.google.com/maps?q=Na%20Kruhovce%20288%2C%20Doln%C3%AD%20Radechov%C3%A1%2054911&output=embed&z=16"></iframe><a href="https://embeddablemap.com" rel="noopener" target="_blank" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;">embed map</a></div>
			</div>
		</section>
		<div class="text-light">
			<p class="m-lg-auto h-4">&copy 2026 Petr Horník a Jakub Tajstra</p>
		</div>
	</footer>
</body>

	<script>
		document.addEventListener('alpine.init', () => {
			Alpine.store('pageName', 'contact');
		});
	</script>
</html>
