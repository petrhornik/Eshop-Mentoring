<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width">

	<title>{ifset title}{include title|stripHtml} | {/ifset}Muj Eshop</title>

	{asset? 'main.js'}
		<link rel="stylesheet" href="{asset? 'CSS/home.css'}">
		<link rel="stylesheet" href="{asset? 'CSS/layout.css'}">
		<link rel="stylesheet" href="{asset? 'CSS/item.css'}">

	<!-- Bootstrap 5 CSS + JSko -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
	<!-- AOS CSS (Animace při scrollování) -->
	<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
	<!-- Animate.css pro animaci košíku -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
	<!-- alpineJS -->
	<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>

<body>
	<nav class="navbar navbar-expand-lg p-3 fs-5 position-sticky top-0 shadow-sm">
		<div class="d-flex justify-content-between w-100 container-fluid">
			<a class="navbar-brand fs-3 mb-0 fw-bold" href="#">Muj Eshop</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>
			<p x-text="active"></p>
			<div class="collapse navbar-collapse" id="navbarSupportedContent" x-data="{ active: '' }">
				<ul class="navbar-nav mb-2 mb-lg-0 ms-auto">
					<li class="nav-item">
						<a class="nav-link active" aria-current="page" n:href="Home:default">Hlavní stránka</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" n:href="ProductList:products">Produkty</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" n:href="AboutUs:about">O nás</a>
					</li>
				</ul>
				<button type="button" class="btn btn-outline-dark d-flex align-items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-basket" viewBox="0 0 16 16">
						<path d="M5.757 1.071a.5.5 0 0 1 .172.686L3.383 6h9.234L10.07 1.757a.5.5 0 1 1 .858-.514L13.783 6H15a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1v4.5a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 1 13.5V9a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h1.217L5.07 1.243a.5.5 0 0 1 .686-.172zM2 9v4.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V9zM1 7v1h14V7zm3 3a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0v-3A.5.5 0 0 1 4 10m2 0a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0v-3A.5.5 0 0 1 6 10m2 0a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0v-3A.5.5 0 0 1 8 10m2 0a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0v-3a.5.5 0 0 1 .5-.5m2 0a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0v-3a.5.5 0 0 1 .5-.5"/>
					</svg>
					<span class="badge text-bg-secondary">0</span>
				</button>
			</div>
		</div>
	</nav>


	<section class="d-flex flex-column align-items-center top-0">
		{include content}
	</section>

	<footer class="py-5 mt-5 bg-dark d-flex flex-column align-items-center justify-content-center">
		<div class="d-flex justify-content-center align-items-center text-light footer-content">
			<div>
				<h4>Máte dotaz? Napište!</h4>
				<div class="input-group ">
					<textarea class="form-control" placeholder="Váš dotaz..."  style="height: 2rem"></textarea>
					<button class="btn btn-outline-light" type="button">Odeslat</button>
				</div>
			</div>
			<div class="d-flex justify-content-center gap-3 text-light align-center">
				<h4>Sledujte nás: </h4>
				<a href="https://www.instagram.com">IG</a>
				<a href="https://www.youtube.com">YT</a>
				<a href="https://www.facebook.com">FB</a>
				<a href="https://www.x.com">X</a>
			</div>
		</div>
		<div class="text-light">
			<p class="m-lg-auto h-4">&copy 2026 Petr Horník a Jakub Tajstra</p>
		</div>
	</footer>
</body>

	<script>
		document.addEventListener('alpine.init', () => {
			Alpine.store('pageName', 'contact');
		});
	</script>
</html>
