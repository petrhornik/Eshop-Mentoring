<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width">

	<title>{ifset title}{include title|stripHtml} | {/ifset}Nette Web</title>

	{asset? 'main.js'}
		<link rel="stylesheet" href="{asset? 'CSS/home.css'}">

	<!-- Bootstrap 5 CSS + JSko -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
	<!-- AOS CSS (Animace při scrollování) -->
	<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
	<!-- Animate.css pro animaci košíku -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

</head>

<body>
	<nav class="navbar navbar-expand-lg bg-body-tertiary p-3 fs-5">
		<div class="container-fluid d-flex justify-content-between">
			<a class="navbar-brand" href="#">Navbar</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse" id="navbarSupportedContent">
				<ul class="navbar-nav me-auto mb-2 mb-lg-0">
					<li class="nav-item">
						<a class="nav-link active" aria-current="page" n:href="Home:default">Hlavní stránka</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" n:href="ProductList:products">Produkty</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" n:href="AboutUs:about">O nás</a>
					</li>
					<li class="nav-item dropdown">
						<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
							Akce
						</a>
						<ul class="dropdown-menu">
							<li><a class="dropdown-item" href="#">Action</a></li>
							<li><a class="dropdown-item" href="#">Another action</a></li>
							<li><hr class="dropdown-divider"></li>
							<li><a class="dropdown-item" href="#">Something else here</a></li>
						</ul>
					</li>
				</ul>
			</div>
		</div>
	</nav>


	<section class="d-flex flex-column align-items-center">
		{include content}
	</section>

	<footer class="py-5 mt-5 bg-dark d-flex">
		<p class="m-lg-auto text-light h-4">&copy 2026 Petr Horník a Jakub Tajstra</p>
	</footer>
</body>
</html>
