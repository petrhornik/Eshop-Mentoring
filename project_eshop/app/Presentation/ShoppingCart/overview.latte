{block title}Košík{/block}

{block content}
    <section class="cart-page py-5">
        <div class="cart-page-shell">
            <div class="cart-page-header">
                <div>
                    <span class="item-section-kicker">Shopping cart</span>
                    <h1>Vybrané produkty</h1>
                    <p>Zde vidíte vše co máte momentálně v DB košíku.</p>
                </div>
                <a n:href="ShoppingCart:payment" class="btn btn-outline-dark">Pokračovat k platbě</a>
            </div>

            <div class="cart-page-grid">
                <section class="cart-page-panel shadow-sm">
                    <div class="cart-page-panel-header">
                        <h2>Položky v košíku</h2>
                        <span data-cart-page-count>{$count_different_products} produktů</span>
                    </div>

                    <div data-cart-page-list></div>

                    <div class="cart-page-empty" data-cart-page-empty>
                        {if $cart_items}
                            {foreach $cart_items as $item}
                                <div class="d-flex justify-content-between">
                                    <p>{$item->product_id} - {$item->ref('products', 'product_id')->name} - {$item->quantity}x</p>
                                    <div>
                                        <a class="btn btn-outline-danger" n:href="removeFromCart!, id => $item->product_id " >Odstranit</a>
                                        <a n:href="Item:show $item->product_id" class="btn btn-outline-dark">Detail produktu</a>
                                    </div>
                                </div>
                            {/foreach}
                        {else}
                            Košík je zatím prázdný. Přidejte produkty z detailu produktu.
                        {/if}
                    </div>
                </section>

                <aside class="cart-page-panel shadow-sm cart-summary-panel">
                    <div class="cart-page-panel-header">
                        <h2>Souhrn</h2>
                    </div>

                    <dl class="cart-summary-list">
                        <div>
                            <dt>Počet kusů</dt>
                            <dd data-cart-summary-qty>{$count_all_products}</dd>
                        </div>
                        <div>
                            <dt>Počet produktů</dt>
                            <dd data-cart-summary-items>{$count_different_products}</dd>
                        </div>
                        <div>
                            <dt>Mezisoučet</dt>
                            <dd data-cart-summary-total>well...jeste to nemam :(</dd>
                        </div>
                    </dl>

                    <a type="button" n:href='removeAllFromCart!' class="btn btn-outline-danger w-100" data-cart-clear>
                        Vymazat košík
                    </a>
                </aside>
            </div>
        </div>
    </section>
{/block}
